{
  "name": "comprafino",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-command.mjs pnpm --filter @comprafino/web dev",
    "build": "node scripts/run-command.mjs turbo run build",
    "lint": "node scripts/run-command.mjs oxlint --type-aware --deny-warnings .",
    "lint:fix": "node scripts/run-command.mjs oxlint --type-aware --fix .",
    "format": "node scripts/run-command.mjs oxfmt --write .",
    "format:check": "node scripts/run-command.mjs oxfmt --check .",
    "docs:check": "node scripts/run-command.mjs node scripts/check-doc-references.mjs",
    "typecheck": "node scripts/run-command.mjs turbo run typecheck",
    "test": "node scripts/run-command.mjs turbo run test",
    "test:e2e": "node scripts/run-command.mjs pnpm --filter @comprafino/web test:e2e",
    "test:integration": "node scripts/run-command.mjs pnpm --filter @comprafino/db test:integration && node scripts/run-command.mjs pnpm --filter @comprafino/web test:integration",
    "db:generate": "node scripts/run-command.mjs pnpm --filter @comprafino/db db:generate",
    "db:migrate": "node scripts/run-command.mjs pnpm --filter @comprafino/db db:migrate",
    "scrape:tottus": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers scrape:tottus",
    "scrape:plaza-vea": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers scrape:plaza-vea",
    "scrape:metro": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers scrape:metro",
    "normalize:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/db normalize:catalog",
    "match:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/db match:catalog",
    "match:evaluate": "node scripts/run-command.mjs pnpm --filter @comprafino/db match:evaluate",
    "match:audit": "node scripts/run-command.mjs pnpm --filter @comprafino/db match:audit",
    "refresh:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers refresh:catalog",
    "discover:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers discover:catalog",
    "refresh:listings": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers refresh:listings",
    "coverage:report": "node scripts/run-command.mjs pnpm --filter @comprafino/db coverage:report",
    "audit:unit-prices": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:unit-prices",
    "audit:staples": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:staples",
    "catalog:budget": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers catalog:budget",
    "audit:quantity-quality": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:quantity-quality",
    "audit:price-history": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:price-history",
    "test:e2e:history": "node scripts/run-command.mjs pnpm --filter @comprafino/db test:e2e:history",
    "audit:observation-coverage": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:observation-coverage",
    "test:db:up": "node scripts/run-command.mjs docker compose -f compose.test.yaml up -d --wait",
    "test:db:down": "node scripts/run-command.mjs docker compose -f compose.test.yaml down",
    "test:integration:local": "node scripts/run-command.mjs node --experimental-strip-types packages/db/src/local-test-cli.ts integration",
    "test:e2e:history:local": "node scripts/run-command.mjs node --experimental-strip-types packages/db/src/local-test-cli.ts history",
    "test:e2e:fixtures:local": "node scripts/run-command.mjs node --experimental-strip-types packages/db/src/local-test-cli.ts history --all",
    "test:e2e:list:local": "node scripts/run-command.mjs node --experimental-strip-types packages/db/src/local-test-cli.ts shopping",
    "benchmark:basket:local": "node scripts/run-command.mjs node --experimental-strip-types packages/db/src/local-test-cli.ts basket",
    "audit:shopping-list": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:shopping-list",
    "audit:catalog-coverage": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:catalog-coverage",
    "audit:availability": "node scripts/run-command.mjs pnpm --filter @comprafino/db audit:availability",
    "health:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/db health:catalog",
    "scrape:makro": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers scrape:makro",
    "acquire:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/scrapers acquire:catalog",
    "derive:catalog": "node scripts/run-command.mjs pnpm --filter @comprafino/db derive:catalog"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.8.1"
}
