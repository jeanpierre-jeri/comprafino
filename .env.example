DATABASE_URL=
# Explicit opt-in for isolated PostgreSQL integration tests; never loaded automatically.
TEST_DATABASE_URL=
# Server-only auth configuration. URL is an exact origin, without a trailing slash.
# HTTP is allowed only for localhost/loopback development.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret of at least 32 characters; never commit real credentials.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
