{
  "name": "@comprafino/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search-filters": "./src/search-filters.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/ingestion.integration.test.ts",
    "normalize:catalog": "node --env-file-if-exists=../../.env --experimental-strip-types src/catalog-cli.ts",
    "match:catalog": "node --env-file-if-exists=../../.env --experimental-strip-types src/matching-cli.ts",
    "match:evaluate": "node --env-file-if-exists=../../.env --experimental-strip-types src/matching-evaluate-cli.ts",
    "match:audit": "node --env-file-if-exists=../../.env --experimental-strip-types src/matching-independent-cli.ts",
    "coverage:report": "node --env-file-if-exists=../../.env --experimental-strip-types src/coverage-cli.ts",
    "audit:unit-prices": "node --env-file-if-exists=../../.env --experimental-strip-types src/unit-price-audit-cli.ts",
    "audit:staples": "node --env-file-if-exists=../../.env --experimental-strip-types src/staple-audit-cli.ts",
    "audit:quantity-quality": "node --env-file-if-exists=../../.env --experimental-strip-types src/quantity-quality-cli.ts",
    "audit:price-history": "node --env-file-if-exists=../../.env --experimental-strip-types src/price-history-audit-cli.ts",
    "test:e2e:history": "node --experimental-strip-types src/price-history-e2e-cli.ts",
    "audit:observation-coverage": "node --env-file-if-exists=../../.env --experimental-strip-types src/observation-coverage-cli.ts"
  },
  "dependencies": {
    "@comprafino/core": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
