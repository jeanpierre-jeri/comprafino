{
  "name": "@comprafino/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/ingestion.integration.test.ts",
    "normalize:catalog": "node --env-file-if-exists=../../.env --experimental-strip-types src/catalog-cli.ts"
  },
  "dependencies": {
    "@comprafino/core": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
