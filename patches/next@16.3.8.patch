@@ -0,0 +1,21 @@
+"use strict";
+// Backport https://github.com/vercel/next.js/pull/96715 to the prebuilt runtimes.
+const { ResponseAborted } = require("../../server/web/spec-extension/adapters/next-request");
+const patched = new WeakSet();
+module.exports = function patchClientAbort(server) {
+  if (patched.has(server)) return;
+  patched.add(server);
+  const render = server.renderToPipeableStream;
+  server.renderToPipeableStream = function (...args) {
+    const pipeable = render.apply(this, args);
+    const pipe = pipeable.pipe;
+    pipeable.pipe = function (destination) {
+      // Register before React's close handler so cancellation has its typed reason.
+      destination.once("close", () => {
+        if (!destination.writableEnded) pipeable.abort(new ResponseAborted());
+      });
+      return pipe.call(this, destination);
+    };
+    return pipeable;
+  };
+};
